{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-chunk ontology-guided extraction payload",
  "type": "object",
  "required": ["entities", "relations"],
  "properties": {
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "nonemptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["quote", "start", "end"],
        "properties": {
          "quote": {"$ref": "#/$defs/nonemptyString"},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1}
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "name", "type", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/nonemptyString"},
        "name": {"$ref": "#/$defs/nonemptyString"},
        "type": {"$ref": "#/$defs/nonemptyString"},
        "ontology_id": {"type": ["string", "null"]},
        "properties": {"type": "object"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "source", "target", "type", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/nonemptyString"},
        "source": {"$ref": "#/$defs/nonemptyString"},
        "target": {"$ref": "#/$defs/nonemptyString"},
        "type": {"$ref": "#/$defs/nonemptyString"},
        "ontology_id": {"type": ["string", "null"]},
        "properties": {"type": "object"},
        "constraints": {"type": "array"},
        "application_conditions": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
